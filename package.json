{
  "name": "adoverride",
  "description": "ADOverride: a Chrome extension for personal Azure DevOps Boards and work item layouts. Your Azure DevOps. Your way.",
  "homepage": "https://github.com/sinmentis/adoverride#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinmentis/adoverride.git"
  },
  "bugs": {
    "url": "https://github.com/sinmentis/adoverride/issues"
  },
  "private": true,
  "version": "0.11.7",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "azure-devops",
    "azure-boards",
    "chrome-extension",
    "work-items",
    "kanban",
    "ui-customization",
    "kiwifruit"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run icons && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "npm run icons && wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "media": "node scripts/media.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@primer/octicons-react": "19.38.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.40.1",
    "@react-aria/live-announcer": "3.5.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "19.3.0",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "jsdom": "30.1.2",
    "vitest": "5.0.3",
    "web-ext": "^10.5.0",
    "wxt": "0.21.4"
  }
}
